# Copy to .env. Never commit real secrets.

APP_ENV=development

# Supabase Postgres URI with psycopg + ssl, e.g.
# postgresql+psycopg://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Local fallback: sqlite:///./data/mailinsider.db
DATABASE_URL=sqlite:///./data/mailinsider.db

JWT_SECRET=replace-with-a-long-random-string
PUBLIC_API_URL=http://127.0.0.1:8765
# Public open-pixel Edge Function (Gmail cannot load localhost images).
# Example: https://YOUR_PROJECT_REF.supabase.co/functions/v1/open-pixel
# Leave empty to use {PUBLIC_API_URL}/t/open (local tests only).
PUBLIC_OPEN_PIXEL_URL=
PUBLIC_APP_URL=http://127.0.0.1:5178
CORS_ORIGINS=http://127.0.0.1:5178,http://localhost:5178

# Supabase Storage (document PDFs / files). Required outside pytest.
# Project Settings → API → Project URL + service_role secret (server only).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DOCUMENTS_BUCKET=documents

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/v1/integrations/gmail/callback
GOOGLE_SHEETS_REDIRECT_URI=http://127.0.0.1:8765/api/v1/integrations/sheets/callback

# AI — local Ollama by default (no cloud key required)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional cloud fallback when AI_PROVIDER=openai or auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
